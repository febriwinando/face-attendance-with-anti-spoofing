<resources>

    <!-- Base application theme. -->
    <style name="AppTheme.ObjectDetection" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/tfe_color_primary</item>
        <item name="colorPrimaryDark">@color/tfe_color_primary_dark</item>
        <item name="colorAccent">@color/tfe_color_accent</item>
    </style>

    <style name="TextLabel">
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="colorAccent">@color/primary_brand</item>
        <item name="colorControlNormal">@color/primary_brand</item>
        <item name="colorControlActivated">@color/primary_brand</item>
    </style>

    <style name="ImageStyle10">
        <item name="cornerSize">10%</item>
    </style>

    <style name="ImageStyleBottom50">
        <item name="cornerSizeBottomLeft">35%</item>
        <item name="cornerSizeBottomRight">35%</item>
    </style>

    <style name="ImageStyleBottomDashOne">
        <item name="cornerSizeBottomLeft">50dp</item>
        <item name="cornerSizeBottomRight">50dp</item>
    </style>

    <style name="mapsCornerRounded">
        <item name="cornerSizeTopLeft">35%</item>
        <item name="cornerSizeTopRight">35%</item>
    </style>

    <style name="ImageStyle2">
        <item name="cornerSize">10%</item>
    </style>

    <style name="DialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="MaterialAlertDialog.App" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/ShapeAppearance.App.MediumComponent</item>
    </style>

    <style name="MaterialAlertDialog.App.Title.Text" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/kuning</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="AppCompatAlertDialogStyle" parent="Theme.Material3.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/primary_brand</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="background">@color/surface_main</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/primary_brand</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="TextStyleInputLogin" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/primary_brand</item>
    </style>

    <!-- Standardized Typography Hierarchy -->
    <style name="AppTypography.Headline" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="AppTypography.Title" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="AppTypography.Body" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="AppTypography.Caption" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <style name="AppTypography.Button" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/on_primary_brand</item>
    </style>

    <style name="NavigationViewStyle" parent="Widget.MaterialComponents.BottomNavigationView">
    </style>

    <style name="Animation.App.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="Widget.App.NumberPicker" parent="android:Widget.Material.NumberPicker">
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

</resources>
