<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Mencegah koneksi HTTP (Cleartext) di seluruh aplikasi -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Mengizinkan domain resmi via HTTPS dengan Sertifikat Sistem & User -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tebingtinggikota.go.id</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
