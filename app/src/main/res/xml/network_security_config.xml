<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Mengizinkan koneksi HTTP (Cleartext) untuk semua IP/Domain pada pengembangan lokal -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">absensi.tebingtinggikota.go.id</domain>
        <domain includeSubdomains="true">svr-absensi.tebingtinggikota.go.id</domain>
        <domain includeSubdomains="true">tebingtinggikota.go.id</domain>
        <domain includeSubdomains="true">192.168.1.2</domain>
        <domain includeSubdomains="true">192.168.1.6</domain>
        <domain includeSubdomains="true">172.15.1.65</domain>
        <domain includeSubdomains="true">172.15.1.35</domain>
        <domain includeSubdomains="true">172.15.5.39</domain>
        <domain includeSubdomains="true">172.15.1.12</domain>
        <domain includeSubdomains="true">172.15.1.13</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
