<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardBackgroundColor="@color/surface_main"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Custom Header -->
        <RelativeLayout
            android:id="@+id/rlHeaderValidasiKedua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvTitleValidasiKedua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-black"
                android:text="Detail Rekap &amp; Validasi Tahap 2"
                android:textColor="@color/primary_brand"
                android:textSize="18sp"
                android:letterSpacing="0.05"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/ivTutupViewListValidasiKedua"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/one_close"
                app:tint="@color/text_hint"
                android:contentDescription="@string/todo" />
        </RelativeLayout>

        <!-- Middle Scrollable Content Area -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvContentValidasiKedua"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:fadeScrollbars="false"
            android:scrollbarSize="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Pegawai Profile Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvNamaRekapValidKedua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp"
                            tools:text="Febri Winando" />

                        <TextView
                            android:id="@+id/tvNipRekapValidKedua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            tools:text="NIP: 199311032022032008" />

                        <TextView
                            android:id="@+id/tvTanggalRekapValidKedua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/primary_brand"
                            android:textSize="13sp"
                            tools:text="📅 Tanggal: 2026-10-15" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section: Absensi Masuk -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvSectionMasukKedua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Absensi Masuk"
                            android:textColor="@color/primary_brand"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            tools:ignore="HardcodedText" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stretchColumns="2"
                            android:shrinkColumns="2">

                            <!-- Pukul Masuk -->
                            <TableRow android:id="@+id/trPukulRekapMasukKedua" android:layout_marginBottom="8dp">
                                <TextView android:text="Pukul" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="sans-serif-medium" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvJamRekapMasukKedua" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="sans-serif-black"/>
                            </TableRow>

                            <!-- Kehadiran -->
                            <TableRow android:id="@+id/trKegiatanRekapMasukKedua" android:layout_marginBottom="8dp">
                                <TextView android:id="@+id/tvKehadiranlabelKedua" android:text="Kehadiran" android:textColor="@color/text_primary" android:textSize="14sp" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvKehadiranRekapMasukKedua" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                            </TableRow>

                            <!-- Keterangan -->
                            <TableRow android:layout_marginBottom="8dp">
                                <TextView android:id="@+id/tvFieldRekapMasukKedua" android:text="Keterangan" android:textColor="@color/text_primary" android:textSize="14sp" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvKeteranganRekapMasukKedua" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                            </TableRow>

                            <!-- Status Validasi -->
                            <TableRow android:layout_marginBottom="8dp">
                                <TextView android:id="@+id/tvFieldStatusMasukKedua" android:text="Status" android:textColor="@color/text_primary" android:textSize="14sp" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvStatusRekapMasukKedua" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                            </TableRow>

                            <!-- Lokasi -->
                            <TableRow android:id="@+id/trAlamatLuarKantorKedua">
                                <TextView android:text="Lokasi" android:textColor="@color/text_primary" android:textSize="14sp" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvLokasiAlamatLuarKantorKedua" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                            </TableRow>
                        </TableLayout>

                        <!-- Photos Masuk -->
                        <TextView
                            android:id="@+id/tvTagFotoRekapMasukKedua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Foto Aktivitas Masuk"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-bold"
                            tools:ignore="HardcodedText" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivValidasiRekapMasukKedua"
                            android:layout_width="match_parent"
                            android:layout_height="280dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ImageStyle2"/>

                        <!-- Attachments Masuk -->
                        <TextView
                            android:id="@+id/tvTagLampiranRekapMasukKedua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Dokumen Lampiran Masuk"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-bold"
                            tools:ignore="HardcodedText" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivLampiranValidasiRekapMasukKedua"
                            android:layout_width="match_parent"
                            android:layout_height="280dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ImageStyle2"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/txtOpenPdfMasukKedua"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="12dp"
                            android:text="Buka Dokumen PDF Masuk"
                            android:visibility="gone"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/one_tl"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section: Absensi Pulang -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvSectionPulangKedua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    app:cardBackgroundColor="@color/surface_variant"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Absensi Pulang"
                            android:textColor="@color/brand_secondary"
                            android:textSize="16sp"
                            android:layout_marginBottom="12dp"
                            tools:ignore="HardcodedText" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:stretchColumns="2"
                            android:shrinkColumns="2">

                            <!-- Pukul Pulang -->
                            <TableRow android:id="@+id/trPukulRekapPulangKedua" android:layout_marginBottom="8dp">
                                <TextView android:text="Pukul" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="sans-serif-medium" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvJamRekapPulangKedua" android:textColor="@color/text_primary" android:textSize="14sp" android:fontFamily="sans-serif-black"/>
                            </TableRow>

                            <!-- Kehadiran Pulang -->
                            <TableRow android:id="@+id/trKegiatanRekapPulangKedua" android:layout_marginBottom="8dp">
                                <TextView android:id="@+id/tvLabelKehadiranKedua" android:text="Kehadiran" android:textColor="@color/text_primary" android:textSize="14sp" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvKehadiranRekapPulangKedua" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-bold"/>
                            </TableRow>

                            <!-- Keterangan Pulang -->
                            <TableRow android:id="@+id/trAktivitasPulangKedua" android:layout_marginBottom="8dp">
                                <TextView android:id="@+id/tvFieldRekapPulangKedua" android:text="Keterangan" android:textColor="@color/text_primary" android:textSize="14sp" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvKeteranganRekapPulangKedua" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                            </TableRow>

                            <!-- Status Pulang -->
                            <TableRow android:layout_marginBottom="8dp">
                                <TextView android:id="@+id/tvFieldStatusPulangKedua" android:text="Status" android:textColor="@color/text_primary" android:textSize="14sp" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvStatusRekapPulangKedua" android:textColor="@color/text_secondary" android:textSize="14sp" android:fontFamily="sans-serif-medium"/>
                            </TableRow>

                            <!-- Lokasi Pulang -->
                            <TableRow android:id="@+id/trAlamatLuarKantorPulangKedua">
                                <TextView android:text="Lokasi" android:textColor="@color/text_primary" android:textSize="14sp" tools:ignore="HardcodedText"/>
                                <TextView android:text=" :  " android:textColor="@color/text_hint" tools:ignore="HardcodedText"/>
                                <TextView android:id="@+id/tvLokasiAlamatLuarKantorPulangKedua" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                            </TableRow>
                        </TableLayout>

                        <!-- Photos Pulang -->
                        <TextView
                            android:id="@+id/tvTagFotoRekapPulangKedua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Foto Aktivitas Pulang"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-bold"
                            tools:ignore="HardcodedText" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAktivitasRekapPulangKedua"
                            android:layout_width="match_parent"
                            android:layout_height="280dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ImageStyle2"/>

                        <!-- Attachments Pulang -->
                        <TextView
                            android:id="@+id/tvTagLampiranRekapPulangKedua"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Dokumen Lampiran Pulang"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-bold"
                            tools:ignore="HardcodedText" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivLampiranRekapPulangKedua"
                            android:layout_width="match_parent"
                            android:layout_height="280dp"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ImageStyle2"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/txtOpenPdfPulangKedua"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="12dp"
                            android:text="Buka Dokumen PDF Pulang"
                            android:visibility="gone"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/one_tl"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 3. Pinned Action Buttons Footer -->
        <LinearLayout
            android:id="@+id/llFooterActionKedua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTerimaKedua"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Terima"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-black"
                app:backgroundTint="@color/hijau"
                app:cornerRadius="16dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTolakKedua"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Tolak"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-black"
                app:backgroundTint="@color/merah"
                app:cornerRadius="16dp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
