<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Top Header Bar (Modern Clean Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivBackChatList"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#0F172A"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Kembali"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAHUT"
                android:textColor="#0F172A"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sarana Hubungan Terpadu"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- Tombol Cari Percakapan (Disamping Tombol Sync) -->
        <ImageView
            android:id="@+id/ivSearchChatToggle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/one_search"
            app:tint="#64748B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Cari Percakapan"/>

        <ImageView
            android:id="@+id/ivRefreshChatList"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_sync2"
            app:tint="#64748B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Refresh"/>

        <!-- Green Round Add (+) Button Matching Mockup -->
        <ImageView
            android:id="@+id/btnHeaderNewChat"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_green_add"
            android:src="@drawable/ic_baseline_add"
            app:tint="#FFFFFF"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mulai Chat Baru"/>
    </LinearLayout>

    <!-- Search Box (Pill Style, Terbuka Saat Tombol Cari Dibuka) -->
    <LinearLayout
        android:id="@+id/llSearchChatContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/one_search"
            app:tint="#94A3B8"
            android:contentDescription="Cari"/>

        <EditText
            android:id="@+id/etSearchChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="Cari percakapan atau nama pegawai..."
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:inputType="text"/>

        <ImageView
            android:id="@+id/ivClearSearchChat"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_close"
            app:tint="#94A3B8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="Hapus Pencarian"/>
    </LinearLayout>

    <!-- Filter Chips / Tabs (Horizontally Scrollable Like Image) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- All Chip -->
            <TextView
                android:id="@+id/tvFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_filter_active"
                android:text="All"
                android:textColor="#16A34A"
                android:textSize="13sp"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Unread Chip -->
            <TextView
                android:id="@+id/tvFilterUnread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_filter_inactive"
                android:text="Unread"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- OPD Chip -->
            <TextView
                android:id="@+id/tvFilterOpd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_filter_inactive"
                android:text="Grup OPD"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- More / OPD Selector Chip (Hidden: Strict Single OPD Group Policy) -->
            <LinearLayout
                android:id="@+id/cvOpdFilterSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_filter_inactive"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvSelectedOpdFilterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pilih OPD"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"/>

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_baseline_add"
                    app:tint="#64748B"
                    android:contentDescription="Tambah Filter"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Message List -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp"/>

        <ProgressBar
            android:id="@+id/pbChatList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#16A34A"
            android:visibility="gone"/>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/llEmptyChatState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_mail"
                app:tint="#CBD5E1"
                android:contentDescription="Pesan Kosong"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Belum Ada Percakapan di SAHUT"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Mulai hubungan komunikasi kedinasan dengan menekan tombol (+) di atas."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Hidden old FAB ID kept for backward compatibility if referenced -->
        <View
            android:id="@+id/btnNewChatFab"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Bottom Navigation Bar Matching Image (Calls | Chats | Settings) -->
    <LinearLayout
        android:id="@+id/llBottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:weightSum="3">

        <!-- Tab 1: Calls / Kontak -->
        <LinearLayout
            android:id="@+id/llTabCalls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_baseline_person_24"
                app:tint="#94A3B8"
                android:contentDescription="Kontak"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Kontak"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

        <!-- Tab 2: Chats (Active Tab) -->
        <LinearLayout
            android:id="@+id/llTabChats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chat_bubble_outline"
                app:tint="#16A34A"
                android:contentDescription="SAHUT"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="SAHUT"
                android:textColor="#16A34A"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"/>
        </LinearLayout>

        <!-- Tab 3: Settings / Privasi -->
        <LinearLayout
            android:id="@+id/llTabSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings_outline"
                app:tint="#94A3B8"
                android:contentDescription="Settings"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Settings"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
