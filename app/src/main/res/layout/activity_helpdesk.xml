<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".helpdesk.HelpdeskActivity">

    <include layout="@layout/layout_background_palette" />



    <!-- Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/rlBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerInParent="true"
                android:src="@drawable/one_left"
                app:tint="@color/text_primary"
                android:contentDescription="@string/todo" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:text="Pusat Bantuan"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/rlBack"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/helpdesk"
                android:contentDescription="@string/todo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-black"
                android:text="Ada Kendala?"
                android:textColor="@color/primary_brand"
                android:textSize="24sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pilih layanan bantuan yang Anda butuhkan di bawah ini."
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <!-- Helpdesk Menu Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:cardBackgroundColor="@color/surface_main"
                app:cardCornerRadius="28dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- 1. Submit Complaint -->
                    <LinearLayout
                        android:id="@+id/llAjukanAduan"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/backgoundovalabuabu"
                            android:backgroundTint="#1A008DDA"
                            android:padding="10dp"
                            android:src="@drawable/ic_artikel"
                            app:tint="@color/primary_brand"
                            android:contentDescription="@string/todo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Ajukan Aduan / Bantuan"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kirim permohonan bantuan teknis"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/one_left"
                            android:rotation="180"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/todo" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/divider_color" />

                    <!-- 2. Helpdesk Guide -->
                    <LinearLayout
                        android:id="@+id/llPanduanHelpdesk"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/backgoundovalabuabu"
                            android:backgroundTint="#1A4CAF50"
                            android:padding="10dp"
                            android:src="@drawable/ic_panduan"
                            app:tint="@color/hijau"
                            android:contentDescription="@string/todo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Panduan Helpdesk"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Petunjuk penggunaan layanan"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/one_left"
                            android:rotation="180"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/todo" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/divider_color" />

                    <!-- 3. Check Complaint Status -->
                    <LinearLayout
                        android:id="@+id/llCekAduan"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/backgoundovalabuabu"
                            android:backgroundTint="#1AF7B620"
                            android:padding="10dp"
                            android:src="@drawable/ic_baseline_list_alt_24"
                            app:tint="@color/kuning"
                            android:contentDescription="@string/todo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Cek Status Aduan"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                tools:ignore="HardcodedText" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pantau riwayat bantuan Anda"
                                android:textColor="@color/text_hint"
                                android:textSize="12sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/one_left"
                            android:rotation="180"
                            app:tint="@color/text_hint"
                            android:contentDescription="@string/todo" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="Layanan Helpdesk Dinas Komunikasi dan Informatika\nKota Tebing Tinggi"
                android:textAlignment="center"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                tools:ignore="HardcodedText" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>