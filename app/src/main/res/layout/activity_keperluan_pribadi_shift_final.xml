<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".izinshift.izinshiftpribadi.KeperluanPribadiSiftFinalActivity">

    <include layout="@layout/layout_background_palette" />

    <!-- 1. Full Screen Background Map -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        class="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Navbar Overlay (Top Left) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/rlHeaderKehadiranOne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/backgoundputihtransparan"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/backTl"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="backFinalDinasLuar"
            android:paddingHorizontal="16dp"
            tools:ignore="UsingOnClickInXml">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/one_left"
                app:tint="@color/text_primary"
                android:contentDescription="@string/todo" />

            <TextView
                android:id="@+id/title_contentkp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-black"
                android:text="Kembali"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/rlBack"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="HardcodedText"  />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Accuracy & Distance Card (Top Right) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAccuracy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/surface_main"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search_location"
                app:tint="@color/primary_brand"
                android:contentDescription="@string/todo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Akurasi"
                    android:textColor="@color/text_hint"
                    android:textSize="9sp"
                    tools:ignore="SmallSp,HardcodedText" />

                <TextView
                    android:id="@+id/tvAkurasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="± 5 m"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvJarak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jarak: - m"
                    android:textColor="@color/primary_brand"
                    android:textSize="9sp"
                    tools:ignore="SmallSp,HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Safe Zone Card (Middle Left) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSafeZone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/surface_main"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.35"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/ivSafeZone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                app:tint="@color/hijau"
                android:contentDescription="@string/todo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSafeZoneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Zona Aman"
                    android:textColor="@color/hijau"
                    android:textSize="11sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvSafeZoneDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anda berada dalam\narea absensi"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp"
                    tools:ignore="SmallSp,HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Weather Card (Bottom Left on Map) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardWeather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/primary_brand"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toTopOf="@+id/cvDataContainer"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <ImageView
                android:id="@+id/ivWeatherIcon"
                android:layout_width="27dp"
                android:layout_height="24dp"
                android:contentDescription="@string/todo"
                android:src="@drawable/ic_morning_w"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTemperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="--°C"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Memuat..."
                    android:textColor="#CCFFFFFF"
                    android:textSize="9sp"
                    tools:ignore="SmallSp,HardcodedText" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- My Location Button (Bottom Right on Map) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnFokusLokasi"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:clickable="true"
        android:focusable="true"
        android:onClick="fokusLokasiSiftIzinKp"
        app:cardBackgroundColor="@color/surface_main"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/cvDataContainer"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:src="@drawable/ic_search_location"
            app:tint="@color/primary_brand"
            android:contentDescription="@string/todo" />
    </androidx.cardview.widget.CardView>

    <!-- 2. Main Data Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvDataContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/surface_main"
        app:cardCornerRadius="20dp"
        app:cardElevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/llKeperluanPribadi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Drag Indicator -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/backgoundovalbirusift"
                android:alpha="0.5" />

            <TextView
                android:id="@+id/titleDinasLuar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:text="Keperluan Pribadi (Shift)"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvKegiatanFinal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/backgoundovalkuning"
                android:text="@string/kegiatan"
                android:textColor="@color/putih"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <!-- Content Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Photo Container -->
                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="130dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="1dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivFinalKegiatanKp"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ImageStyle2" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="2dp"
                        app:cardBackgroundColor="@color/primary_brand"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/white"
                            android:contentDescription="@string/todo" />
                    </androidx.cardview.widget.CardView>
                </RelativeLayout>

                <!-- Right Selection Area -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Segmented Control -->
                    <RadioGroup
                        android:id="@+id/rgKehadiran"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/backgroundwhiteradius"
                        android:backgroundTint="@color/surface_variant"
                        android:orientation="horizontal"
                        android:padding="3dp">

                        <RadioButton
                            android:id="@+id/rbtnMasuk"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_radio_masuk"
                            android:button="@null"
                            android:checked="true"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:drawableStart="@drawable/ic_masuk_kanan"
                            android:paddingStart="8dp"
                            android:text="@string/masuk"
                            android:textColor="@color/color_radio_masuk_pulang"
                            android:textSize="12sp"
                            android:letterSpacing="0.05"
                            tools:ignore="RtlSymmetry" />

                        <RadioButton
                            android:id="@+id/rbtnPulang"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_radio_pulang"
                            android:button="@null"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center"
                            android:drawableStart="@drawable/ic_pulang_kiri"
                            android:paddingStart="8dp"
                            android:text="@string/pulang"
                            android:textColor="@color/color_radio_masuk_pulang"
                            android:textSize="12sp"
                            android:letterSpacing="0.05"
                            tools:ignore="RtlSymmetry" />

                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pilih status kehadiran Anda untuk keperluan pribadi."
                        android:textColor="@color/text_hint"
                        android:textSize="10sp"
                        tools:ignore="SmallSp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Send Button -->
            <LinearLayout
                android:id="@+id/llUpload"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_gradient_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:onClick="kirimDataDinasLuar"
                android:orientation="horizontal"
                android:elevation="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="KIRIM PERMOHONAN"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:letterSpacing="0.05"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
