<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivBackChatPrivacy"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#0F172A"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Kembali"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengaturan SAHUT"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sarana Hubungan Terpadu"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivSyncPrivacy"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_sync2"
            app:tint="#0F172A"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Sinkronkan Privasi"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Khusus Monitoring Sistem (Hanya tampil jika penggunanya adalah NIP 199402092020121005) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvMonitoringSettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#C7D2FE"
                app:cardBackgroundColor="#EEF2FF"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_opd_badge"
                        android:backgroundTint="#E0E7FF">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_document_scanner"
                            app:tint="#3730A3"
                            android:contentDescription="Monitoring"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monitoring Sistem SAHUT"
                            android:textColor="#3730A3"
                            android:textSize="14.5sp"
                            android:fontFamily="sans-serif-black"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sarana Hubungan Terpadu (NIP 199402092020121005)"
                            android:textColor="#4338CA"
                            android:textSize="11.5sp"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_arrow_back"
                        android:rotation="180"
                        app:tint="#3730A3"
                        android:contentDescription="Buka Monitoring"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Siapa yang dapat melihat kontak &amp; mengirim pesan ke Anda?"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <RadioGroup
                    android:id="@+id/rgPrivacyMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <RadioButton
                        android:id="@+id/rbPublic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Semua Pegawai (Publik)"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:paddingVertical="8dp"/>

                    <RadioButton
                        android:id="@+id/rbPrivate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sembunyikan dari Semua (Sangat Privat)"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:paddingVertical="8dp"/>

                    <RadioButton
                        android:id="@+id/rbCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tampilkan Hanya ke Pegawai / OPD Terpilih"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:paddingVertical="8dp"/>
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Custom Selected Section -->
            <LinearLayout
                android:id="@+id/llCustomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <!-- Select Employees -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pegawai Terpilih"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvSelectedEmployeesSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:text="Belum ada pegawai dipilih"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectEmployees"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pilih Pegawai"
                            app:cornerRadius="8dp"
                            android:backgroundTint="#16A34A"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Select OPDs -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Unit Kerja / OPD Terpilih"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvSelectedOpdSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:text="Belum ada OPD dipilih"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectOpd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pilih OPD"
                            app:cornerRadius="8dp"
                            android:backgroundTint="#16A34A"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Read Receipts Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Laporan Dibaca (Centang Biru)"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Kirim &amp; Tampilkan Tanda Dibaca"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchReadReceipts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Jika dinonaktifkan, Anda tidak akan mengirim tanda telah membaca pesan orang lain, dan tidak akan melihat tanda centang biru pada pesan Anda."
                        android:textColor="#64748B"
                        android:textSize="12sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Profile Photo Privacy Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Privasi Foto Profil"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <RadioGroup
                    android:id="@+id/rgProfilePhotoPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <RadioButton
                        android:id="@+id/rbPhotoEveryone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Semua Pegawai"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:paddingVertical="6dp"/>

                    <RadioButton
                        android:id="@+id/rbPhotoSameOpd"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Hanya Rekan Satu Unit Kerja (OPD)"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:paddingVertical="6dp"/>

                    <RadioButton
                        android:id="@+id/rbPhotoNobody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tidak Ada (Sembunyikan Semua)"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:paddingVertical="6dp"/>
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Blocked Contacts Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kontak yang Diblokir"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvBlockedSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada kontak yang diblokir"
                        android:textColor="#64748B"
                        android:textSize="13sp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageBlocked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Kelola Kontak Diblokir"
                        app:cornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#CBD5E1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="#0F172A"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePrivacy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Simpan Pengaturan Privasi"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-bold"
                app:cornerRadius="26dp"
                android:backgroundTint="#16A34A"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
