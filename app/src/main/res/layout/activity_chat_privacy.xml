<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2563EB"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivBackChatPrivacy"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Kembali"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Privasi Kontak Chat"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Siapa yang dapat melihat kontak &amp; mengirim pesan ke Anda?"
                android:textColor="#1E293B"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <RadioGroup
                    android:id="@+id/rgPrivacyMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <RadioButton
                        android:id="@+id/rbPublic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Semua Pegawai (Publik)"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:paddingVertical="8dp"/>

                    <RadioButton
                        android:id="@+id/rbPrivate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sembunyikan dari Semua (Sangat Privat)"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:paddingVertical="8dp"/>

                    <RadioButton
                        android:id="@+id/rbCustom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tampilkan Hanya ke Pegawai / OPD Terpilih"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:paddingVertical="8dp"/>
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Custom Selected Section -->
            <LinearLayout
                android:id="@+id/llCustomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <!-- Select Employees -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pegawai Terpilih"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvSelectedEmployeesSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:text="Belum ada pegawai dipilih"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectEmployees"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pilih Pegawai"
                            app:cornerRadius="8dp"
                            android:backgroundTint="#2563EB"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Select OPDs -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Unit Kerja / OPD Terpilih"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvSelectedOpdSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:text="Belum ada OPD dipilih"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectOpd"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Pilih OPD"
                            app:cornerRadius="8dp"
                            android:backgroundTint="#2563EB"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePrivacy"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Simpan Pengaturan Privasi"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="#2563EB"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
