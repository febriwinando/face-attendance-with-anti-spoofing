<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <TextView
            android:id="@+id/txtHariJadwal"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:background="@drawable/backgoundovalkuning"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textAlignment="center"
            android:textColor="@color/fixed_black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMasukJadwal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/backgoundovalbirusift"
            android:padding="5dp"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPulangJadwal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/backgoundovalbirusift"
            android:padding="5dp"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>