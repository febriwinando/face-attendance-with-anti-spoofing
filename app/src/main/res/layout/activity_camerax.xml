<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".camerax.CameraxActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="compatible" />

    <!-- Face Overlay View (Custom View) -->
    <go.pemkott.appsandroidmobiletebingtinggi.camerax.FaceOverlayView
        android:id="@+id/faceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Controls -->
    <LinearLayout
        android:id="@+id/llTopControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="20dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/toggleFlash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/backgoundputihtransparan"
            android:contentDescription="@string/todo"
            android:padding="12dp"
            android:src="@drawable/flash"
            android:visibility="gone"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/flipCamera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/backgoundputihtransparan"
            android:contentDescription="@string/todo"
            android:padding="12dp"
            android:src="@drawable/flip"
            android:visibility="gone"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Instruction Label -->
    <TextView
        android:id="@+id/txtChallenge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:background="@drawable/backgroundtranshitam"
        android:fontFamily="sans-serif-black"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:text="Arahkan wajah ke frame"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/capture"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Capture Button -->
    <ImageButton
        android:id="@+id/capture"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginBottom="48dp"
        android:background="@drawable/one_take_picture"
        android:contentDescription="@string/todo"
        android:scaleType="centerInside"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/white" />

    <!-- Back Button Area -->
    <ImageButton
        android:id="@+id/ivBackCamera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/backgoundputihtransparan"
        android:padding="12dp"
        android:src="@drawable/one_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white"
        android:contentDescription="@string/todo" />

</androidx.constraintlayout.widget.ConstraintLayout>