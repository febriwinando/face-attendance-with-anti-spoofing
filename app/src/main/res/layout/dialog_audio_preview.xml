<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:backgroundTint="#0F172A"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#334155"
        app:cardCornerRadius="2.5dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp" />

    <!-- Top Bar: Title & Close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemutar Audio SAHUT"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/tvAudioStatusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Pesan Suara / Lampiran Audio"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flCloseAudioPreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCloseAudioPreview"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFF"
                android:contentDescription="Tutup"/>
        </FrameLayout>
    </RelativeLayout>

    <!-- Center Card: Audio Artwork & Waveform -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1E293B"
        app:cardBackgroundColor="#1E293B">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- Artwork Badge -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_circle_glass_button">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mic"
                    app:tint="#38BDF8"
                    android:contentDescription="Audio Track"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvAudioFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Audio Lampiran"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:ellipsize="middle"/>

            <!-- Buffering Spinner -->
            <ProgressBar
                android:id="@+id/pbAudioLoading"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="#38BDF8"
                android:layout_marginTop="8dp"
                android:visibility="gone"/>

            <!-- Voice Note Waveform Visualizer Inside Modal -->
            <go.pemkott.appsandroidmobiletebingtinggi.widget.AudioWaveformView
                android:id="@+id/waveformAudioModal"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Progress SeekBar Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAudioCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"/>

        <SeekBar
            android:id="@+id/sbAudioProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:progressTint="#38BDF8"
            android:thumbTint="#FFFFFF"
            android:max="100"/>

        <TextView
            android:id="@+id/tvAudioTotalDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Controls Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Speed Badge (1.0x, 1.25x, 1.5x, 2.0x) -->
        <TextView
            android:id="@+id/tvAudioSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_speed_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-bold"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Center Buttons -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAudioReplay10"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_replay_10"
                app:tint="#E2E8F0"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mundur 10 Detik"/>

            <!-- Circular Play/Pause Button -->
            <FrameLayout
                android:id="@+id/flAudioModalPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="18dp"
                android:background="@drawable/bg_circle_solid_white"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAudioModalPlayPause"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_voice_play_rounded"
                    app:tint="#0F172A"
                    android:contentDescription="Putar / Jeda"/>
            </FrameLayout>

            <ImageView
                android:id="@+id/ivAudioForward10"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_forward_10"
                app:tint="#E2E8F0"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Maju 10 Detik"/>
        </LinearLayout>

        <!-- Download Action -->
        <FrameLayout
            android:id="@+id/flAudioDownload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivAudioDownload"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_file_download"
                app:tint="#FFFFFF"
                android:contentDescription="Unduh Audio"/>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
