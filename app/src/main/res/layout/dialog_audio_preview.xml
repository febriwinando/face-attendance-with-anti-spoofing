<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:backgroundTint="#0F172A"
    android:paddingHorizontal="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="26dp">

    <!-- Top Drag Handle -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="#334155"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp" />

    <!-- Top Header Bar: SAHUT Branding & Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemutar Audio SAHUT"
                android:textColor="#FFFFFF"
                android:textSize="16.5sp"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/tvAudioStatusSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Sarana Hubungan Terpadu • Pesan Suara"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- Close Button -->
        <FrameLayout
            android:id="@+id/flCloseAudioPreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCloseAudioPreview"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFF"
                android:contentDescription="Tutup"/>
        </FrameLayout>
    </RelativeLayout>

    <!-- Dedicated Audio Visualizer Card (SAHUT Blue Accent) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#2E38BDF8"
        app:cardBackgroundColor="#162032">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <!-- Card Header: Audio Badge & Title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_glass_button">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_mic"
                        app:tint="#38BDF8"
                        android:contentDescription="Audio SAHUT"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvAudioFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="Pesan Suara SAHUT"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:ellipsize="middle"/>

                <!-- Buffering Spinner in SAHUT Blue -->
                <ProgressBar
                    android:id="@+id/pbAudioLoading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminateTint="#38BDF8"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Dynamic Waveform & Equalizer Visualizer -->
            <go.pemkott.appsandroidmobiletebingtinggi.widget.AudioWaveformView
                android:id="@+id/waveformAudioModal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Timeline Progress Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tvAudioCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:fontFamily="monospace"
            android:textStyle="bold"/>

        <SeekBar
            android:id="@+id/sbAudioProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:progressTint="#38BDF8"
            android:thumbTint="#FFFFFF"
            android:max="100"/>

        <TextView
            android:id="@+id/tvAudioTotalDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <!-- Bottom Controls Row: Speed, Replay, Central SAHUT Play Button, Forward, Download -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- Speed Badge (1.0x, 1.25x, 1.5x, 2.0x) -->
        <TextView
            android:id="@+id/tvAudioSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_speed_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-bold"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Center Controls Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAudioReplay10"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_replay_10"
                app:tint="#CBD5E1"
                android:padding="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Mundur 10 Detik"/>

            <!-- Prominent Central Play/Pause Button in SAHUT Blue -->
            <FrameLayout
                android:id="@+id/flAudioModalPlayPause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="18dp"
                android:background="@drawable/bg_circle_sahut_blue"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivAudioModalPlayPause"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_voice_play_rounded"
                    app:tint="#FFFFFF"
                    android:contentDescription="Putar / Jeda Audio"/>
            </FrameLayout>

            <ImageView
                android:id="@+id/ivAudioForward10"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_forward_10"
                app:tint="#CBD5E1"
                android:padding="5dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Maju 10 Detik"/>
        </LinearLayout>

        <!-- Download Action Button -->
        <FrameLayout
            android:id="@+id/flAudioDownload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivAudioDownload"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_file_download"
                app:tint="#FFFFFF"
                android:contentDescription="Unduh Berkas Audio"/>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>