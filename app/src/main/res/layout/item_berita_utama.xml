<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="180dp"
    android:layout_marginVertical="6dp"
    android:layout_marginEnd="14dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_main"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivThumbnailUtama"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Thumbnail Utama"
            android:scaleType="centerCrop"
            android:src="@drawable/one_person" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_news_overlay" />

        <TextView
            android:id="@+id/tvBadgeUtama"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/background_category_badge"
            android:backgroundTint="#FF9800"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="⭐ UTAMA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvJudulUtama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="Diskominfo Tebing Tinggi Mengembangkan Sistem Informasi Terbaru" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTanggalUtama"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    tools:text="10 Feb 2026" />

                <TextView
                    android:id="@+id/tvViewsUtama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp"
                    tools:text="👁️ 125x" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
