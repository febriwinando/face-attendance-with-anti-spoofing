<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clMainDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".berita.DetailBeritaActivity">

    <!-- 1. Background Palette (Consistent with LoginActivity & Dashboard) -->
    <include layout="@layout/layout_background_palette" />

    <!-- 2. Header Bar -->
    <RelativeLayout
        android:id="@+id/rlDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_main"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="DETAIL BERITA"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Diskominfo Tebing Tinggi"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvShare"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface_main"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Bagikan Berita"
                android:src="@drawable/ic_share_white"
                app:tint="@color/primary_brand" />
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <!-- 3. Scrolling Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rlDetailHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingBottom="32dp">

            <!-- Progress Bar Loading -->
            <ProgressBar
                android:id="@+id/pbLoadingDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                android:indeterminateTint="@color/primary_brand"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Main Content Card (Matches cvLogin MaterialCardView) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvDetailContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="@color/surface_main"
                app:cardCornerRadius="28dp"
                app:cardElevation="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Thumbnail Image Container Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/ivHeaderThumbnail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Thumbnail Berita"
                                android:scaleType="centerCrop"
                                android:src="@drawable/one_person" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/gradient_news_overlay" />

                            <TextView
                                android:id="@+id/tvDetailCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_margin="12dp"
                                android:background="@drawable/background_category_badge"
                                android:backgroundTint="@color/primary_brand"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="PEMERINTAHAN" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Date & Views Info -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/tvDetailDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text="Senin, 10 Februari 2026" />

                        <TextView
                            android:id="@+id/tvDetailViews"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/primary_brand"
                            android:textSize="12sp"
                            tools:text="👁️ 152x dilihat" />
                    </RelativeLayout>

                    <!-- Judul Berita -->
                    <TextView
                        android:id="@+id/tvDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        tools:text="Pemko Tebing Tinggi Terus Tingkatkan Kualitas Layanan Digital Publik" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="16dp"
                        android:background="@color/surface_variant" />

                    <!-- Penulis / Redaksi Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/ciAuthor"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="@drawable/one_person"
                            app:civ_border_color="@color/primary_brand"
                            app:civ_border_width="1.5dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailAuthor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                tools:text="Redaksi Diskominfo" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Pemerintah Kota Tebing Tinggi"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Summary Highlight Box -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/surface_variant"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tvDetailSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:lineSpacingExtra="4dp"
                            android:padding="16dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            tools:text="Ringkasan singkat berita mengenai program prioritas kominfo..." />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Isi Berita Full (Native Render) -->
                    <TextView
                        android:id="@+id/tvDetailContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="6dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        tools:text="Isi artikel berita lengkap disajikan secara native tanpa webview..." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
