<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlFullImageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811">

    <!-- Edge-to-Edge Zoomable Image View -->
    <go.pemkott.appsandroidmobiletebingtinggi.widget.ZoomableImageView
        android:id="@+id/ivFullImagePreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Pratinjau Foto"/>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbImagePreview"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#38BDF8"/>

    <!-- Floating Frosted Glass Top Header -->
    <LinearLayout
        android:id="@+id/llTopBarPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_floating_glass_header"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/flCloseImagePreview"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCloseImagePreview"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"
                android:contentDescription="Kembali"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pratinjau Foto SAHUT"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvPreviewSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Cubit untuk zoom in/out • Ketuk untuk layar penuh"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flDownloadImage"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDownloadImage"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_file_download"
                app:tint="#FFFFFF"
                android:contentDescription="Unduh Gambar"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Floating Glass Bottom Bar for Quick Actions (Reset Zoom & Info) -->
    <LinearLayout
        android:id="@+id/llBottomImageBar"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_floating_glass_card"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvResetZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_speed_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="1:1 Reset Zoom"
            android:textColor="#38BDF8"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-bold"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="Foto SAHUT Kedinasan"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

</FrameLayout>
