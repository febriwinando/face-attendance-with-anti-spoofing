<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootValidasi"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".verifikasi.ValidasiNewActivity">

    <!-- Background Palette matching DashboardVersiOne -->
    <include layout="@layout/layout_background_palette" />

    <!-- 1. Top Header Profile Bar (Identical to DashboardVersiOne Header) -->
    <RelativeLayout
        android:id="@+id/rlHeaderValidasi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivBackValidasi"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/one_left"
            app:tint="@color/text_primary"
            android:contentDescription="@string/todo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/ivBackValidasi"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Panel Verifikasi"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvTitleHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"
                android:text="Verifikasi Presensi"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvSummaryVerifikasi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:text="Menunggu: 0 data • Masuk: 0 | Pulang: 0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. Segmented Pill Switcher Card (Identical to Dashboard Card Style) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvSegmentedTab"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="@color/surface_main"
        app:cardCornerRadius="27dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/rlHeaderValidasi">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/backgoundovalabuabu"
            android:backgroundTint="@color/surface_variant"
            android:orientation="horizontal"
            android:padding="4dp">

            <!-- Tab Masuk -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnTabMasuk"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface_main"
                app:cardCornerRadius="23dp"
                app:cardElevation="4dp">

                <TextView
                    android:id="@+id/tvTabMasuk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-black"
                    android:text="Validasi Masuk"
                    android:textColor="@color/primary_brand"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />
            </androidx.cardview.widget.CardView>

            <!-- Tab Pulang -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnTabPulang"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvTabPulang"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-bold"
                    android:text="Validasi Pulang"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Smooth ViewPager2 Container -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpValidasi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvSegmentedTab" />

</androidx.constraintlayout.widget.ConstraintLayout>
