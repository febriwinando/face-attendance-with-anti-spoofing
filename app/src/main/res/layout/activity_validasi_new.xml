<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:context=".verifikasi.ValidasiNewActivity">

    <!-- Decorative Glows (Consistency with Login) -->
    <View
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="@drawable/backgoundovalabuabu"
        android:backgroundTint="@color/primary_brand"
        android:alpha="0.06"
        android:translationX="-120dp"
        android:translationY="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/backgoundovalabuabu"
        android:backgroundTint="@color/brand_secondary"
        android:alpha="0.08"
        android:translationX="100dp"
        android:translationY="-50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/containervalidasi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cvMenuContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Modern Floating Bottom Navigation Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvMenuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/surface_main"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="0dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/menuvalidasi"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/bnv_selector"
            app:itemTextColor="@color/bnv_selector"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/listvalidasi" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>