<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_rounded_top"
    android:paddingTop="12dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill_search_inactive"
        android:layout_marginBottom="12dp"/>

    <!-- Header Actions -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Profil Grup OPD"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/ivCloseGroupProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            app:tint="@color/text_secondary"
            android:contentDescription="Tutup"/>
    </RelativeLayout>

    <!-- Group Information Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/civGroupProfileAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_locasi_office"
            app:civ_border_width="2dp"
            app:civ_border_color="#16A34A"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvGroupProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grup OPD"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="2"/>

        <TextView
            android:id="@+id/tvGroupProfileSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Grup Resmi Kedinasan OPD"
            android:textColor="@color/opd_badge_icon"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvGroupProfileDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Grup koordinasi dan komunikasi kedinasan resmi untuk seluruh pegawai pada OPD terkait."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"/>

    <!-- Search Member Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_search_input"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/one_search"
            app:tint="@color/text_hint"/>

        <EditText
            android:id="@+id/etSearchGroupMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@null"
            android:hint="Cari nama atau NIP anggota..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvGroupMemberHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="DAFTAR ANGGOTA PEGAWAI"
        android:textColor="@color/text_hint"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"/>

    <!-- Members Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="240dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroupMembers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp"/>

        <ProgressBar
            android:id="@+id/pbLoadingGroupMembers"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="#16A34A"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvEmptyGroupMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Pegawai tidak ditemukan"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:visibility="gone"/>
    </FrameLayout>

</LinearLayout>
