<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="95dp"
    android:layout_height="95dp"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeWidth="1.5dp"
    app:strokeColor="@color/surface_variant">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/todo"
            android:background="@color/surface_variant" />

        <!-- High-quality Play Icon Overlay -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ivPlayIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#99000000"
            app:cardCornerRadius="18dp"
            app:strokeWidth="0dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                app:tint="@color/white"
                android:contentDescription="@string/todo" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Premium Delete Button with Blur Effect (via background color) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ivRemove"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#EEFF5252"
            app:cardCornerRadius="13dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:src="@drawable/one_close"
                app:tint="@color/white"
                android:contentDescription="@string/todo" />
        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>