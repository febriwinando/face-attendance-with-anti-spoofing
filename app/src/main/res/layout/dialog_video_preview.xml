<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlVideoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090F">

    <!-- Center Cinematic Video View -->
    <VideoView
        android:id="@+id/vvVideoPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Buffering Progress Spinner in SAHUT Accent -->
    <ProgressBar
        android:id="@+id/pbVideoLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#38BDF8"
        android:visibility="visible" />

    <!-- Center Glowing Play Button Overlay -->
    <FrameLayout
        android:id="@+id/flCenterPlayPause"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_circle_sahut_play_glass"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivCenterPlayPause"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_arrow"
            app:tint="#FFFFFF"
            android:contentDescription="Putar / Jeda Video"/>
    </FrameLayout>

    <!-- Floating Top Header Bar -->
    <LinearLayout
        android:id="@+id/llTopBarVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_floating_glass_header"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <!-- Back Button -->
        <FrameLayout
            android:id="@+id/flCloseVideoPreview"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCloseVideoPreview"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"
                android:contentDescription="Kembali"/>
        </FrameLayout>

        <!-- Video Metadata -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pemutar Video SAHUT"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="middle"/>

            <TextView
                android:id="@+id/tvVideoSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Video Layanan SAHUT"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Download Action Button -->
        <FrameLayout
            android:id="@+id/flDownloadVideo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDownloadVideo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_file_download"
                app:tint="#FFFFFF"
                android:contentDescription="Unduh Video"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Floating Bottom Controls Card (Clean & Simple) -->
    <LinearLayout
        android:id="@+id/llBottomControlVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_glass_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- Timeline Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVideoCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/sbVideoProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:progressTint="#38BDF8"
                android:thumbTint="#FFFFFF"
                android:max="100"/>

            <TextView
                android:id="@+id/tvVideoTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Playback Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <!-- Speed Toggle Button (1.0x, 1.25x, 1.5x, 2.0x) -->
            <TextView
                android:id="@+id/tvVideoSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_speed_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Center Controls -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivVideoReplay10"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_replay_10"
                    app:tint="#CBD5E1"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Mundur 10 Detik"/>

                <!-- Primary Play/Pause Button in SAHUT Blue -->
                <FrameLayout
                    android:id="@+id/flVideoBtnPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="18dp"
                    android:background="@drawable/bg_circle_sahut_blue"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivVideoBtnPlayPause"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_arrow"
                        app:tint="#FFFFFF"
                        android:contentDescription="Putar / Jeda"/>
                </FrameLayout>

                <ImageView
                    android:id="@+id/ivVideoForward10"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_forward_10"
                    app:tint="#CBD5E1"
                    android:padding="5dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Maju 10 Detik"/>
            </LinearLayout>

            <!-- SAHUT Brand Pill Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_sahut_badge"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="SAHUT"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:fontFamily="sans-serif-black"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>