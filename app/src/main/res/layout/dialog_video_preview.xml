<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlVideoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Full-screen Cinematic Video View -->
    <VideoView
        android:id="@+id/vvVideoPlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Buffering Spinner -->
    <ProgressBar
        android:id="@+id/pbVideoLoading"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center"
        android:indeterminateTint="#38BDF8"
        android:visibility="visible" />

    <!-- Center Big Play Button Overlay -->
    <FrameLayout
        android:id="@+id/flCenterPlayPause"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_circle_play"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivCenterPlayPause"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_arrow"
            app:tint="#FFFFFF"
            android:contentDescription="Putar/Jeda"/>
    </FrameLayout>

    <!-- Floating Frosted Glass Top Header -->
    <LinearLayout
        android:id="@+id/llTopBarVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_floating_glass_header"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/flCloseVideoPreview"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivCloseVideoPreview"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF"
                android:contentDescription="Kembali"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pemutar Video SAHUT"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvVideoSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Video Kedinasan SAHUT"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flDownloadVideo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivDownloadVideo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_file_download"
                app:tint="#FFFFFF"
                android:contentDescription="Unduh Video"/>
        </FrameLayout>
    </LinearLayout>

    <!-- Floating Glass Video Controls Card (Bottom) -->
    <LinearLayout
        android:id="@+id/llBottomControlVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_glass_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Progress Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVideoCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>

            <SeekBar
                android:id="@+id/sbVideoProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:progressTint="#38BDF8"
                android:thumbTint="#FFFFFF"
                android:max="100"/>

            <TextView
                android:id="@+id/tvVideoTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Control Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Speed Toggle Button (1.0x, 1.25x, 1.5x, 2.0x) -->
            <TextView
                android:id="@+id/tvVideoSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_speed_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="1.0x"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:fontFamily="sans-serif-bold"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Center Buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivVideoReplay10"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_replay_10"
                    app:tint="#E2E8F0"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mundur 10 Detik"/>

                <!-- Circular Play/Pause Button -->
                <FrameLayout
                    android:id="@+id/flVideoBtnPlayPause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/bg_circle_solid_white"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/ivVideoBtnPlayPause"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_arrow"
                        app:tint="#0F172A"
                        android:contentDescription="Putar / Jeda"/>
                </FrameLayout>

                <ImageView
                    android:id="@+id/ivVideoForward10"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_forward_10"
                    app:tint="#E2E8F0"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Maju 10 Detik"/>
            </LinearLayout>

            <!-- Status Indicator / Info -->
            <TextView
                android:id="@+id/tvVideoMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_speed_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:text="HD"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
