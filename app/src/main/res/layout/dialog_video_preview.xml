<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/llTopBarVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:background="#99000000"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/ivCloseVideoPreview"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Tutup"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemutar Video"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video Kedinasan"
                android:textColor="#94A3B8"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Video Playback Container -->
    <FrameLayout
        android:id="@+id/flVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llTopBarVideo"
        android:layout_above="@id/llBottomControlVideo"
        android:background="#000000">

        <VideoView
            android:id="@+id/vvVideoPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Buffering Spinner -->
        <ProgressBar
            android:id="@+id/pbVideoLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#38BDF8"
            android:visibility="visible" />

        <!-- Center Play/Pause Overlay Icon -->
        <ImageView
            android:id="@+id/ivCenterPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play_arrow"
            android:background="@drawable/bg_circle_play"
            android:padding="14dp"
            app:tint="#FFFFFF"
            android:visibility="gone"
            android:contentDescription="Putar/Jeda"/>
    </FrameLayout>

    <!-- Bottom Controls Overlay Bar -->
    <LinearLayout
        android:id="@+id/llBottomControlVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:background="#99000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvVideoCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#E2E8F0"
                android:textSize="12sp"/>

            <SeekBar
                android:id="@+id/sbVideoProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="#38BDF8"
                android:thumbTint="#38BDF8"
                android:max="100"/>

            <TextView
                android:id="@+id/tvVideoTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#94A3B8"
                android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivVideoReplay10"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_replay_10"
                app:tint="#E2E8F0"
                android:layout_marginEnd="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Mundur 10 Detik"/>

            <ImageView
                android:id="@+id/ivVideoBtnPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_play_arrow"
                android:background="@drawable/bg_circle_play"
                android:padding="10dp"
                app:tint="#FFFFFF"
                android:contentDescription="Putar / Jeda"/>

            <ImageView
                android:id="@+id/ivVideoForward10"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_forward_10"
                app:tint="#E2E8F0"
                android:layout_marginStart="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Maju 10 Detik"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>

