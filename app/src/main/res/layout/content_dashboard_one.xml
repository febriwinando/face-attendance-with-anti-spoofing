<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:showIn="@layout/activity_dashboard_versi_one">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="40dp">

            <!-- 1. Immersive Header with Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivHeaderImage"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:scaleType="centerCrop"
                android:src="@drawable/tebingtinggikota"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ImageStyleBottomDashOne" />

            <View
                android:id="@+id/llBagroundHeaderGambar"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@drawable/backgroundbirutransparan"
                android:alpha="0.8"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 2. Profile & Notification Bar -->
            <RelativeLayout
                android:id="@+id/rlHeaderDashboardOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:paddingHorizontal="24dp"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selamat Datang,"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvNamaUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/text_putih"
                        android:textSize="18sp"
                        tools:text="Febri Winando" />
                </LinearLayout>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/ciUser"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/one_person"
                    app:civ_border_color="@color/white"
                    app:civ_border_width="2dp" />
            </RelativeLayout>

            <!-- 3. Floating Quick Actions Panel -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvMainContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="-80dp"
                app:cardBackgroundColor="@color/surface_main"
                app:cardCornerRadius="32dp"
                app:cardElevation="12dp"
                app:layout_constraintTop_toBottomOf="@+id/ivHeaderImage"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <!-- Search / Rekap Bar (Must be ConstraintLayout per Java code) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clCariRekap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/backgoundovalabuabu"
                        android:backgroundTint="@color/surface_variant"
                        android:padding="12dp"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/cari_rekap_kehadiran"
                            android:textColor="@color/text_hint"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/one_search"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/primary_brand" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Primary Actions Grid -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clPresensi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:layout_constraintTop_toBottomOf="@+id/clCariRekap">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvKehadiran"
                            android:layout_width="0dp"
                            android:layout_height="130dp"
                            android:layout_margin="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/primary_brand"
                            app:cardCornerRadius="24dp"
                            app:layout_constraintEnd_toStartOf="@+id/cvMenuPerjalananDinas"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:id="@+id/llKehadiran"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/backgoundputihtransparan"
                                    android:padding="10dp"
                                    android:src="@drawable/one_kehadiran"
                                    app:tint="@color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-black"
                                    android:text="@string/kehadiran"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvMenuPerjalananDinas"
                            android:layout_width="0dp"
                            android:layout_height="130dp"
                            android:layout_margin="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/brand_secondary"
                            app:cardCornerRadius="24dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_weight="1"
                            app:layout_constraintStart_toEndOf="@+id/cvKehadiran"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:id="@+id/llPerjalananDinas"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:background="@drawable/backgoundputihtransparan"
                                    android:padding="10dp"
                                    android:src="@drawable/one_perjalanan_dinas"
                                    app:tint="@color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="sans-serif-black"
                                    android:text="Dinas Luar"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvMenuIzin"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_margin="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/hijau"
                            app:cardCornerRadius="24dp"
                            app:layout_constraintTop_toBottomOf="@+id/cvKehadiran"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:id="@+id/llIzin"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="24dp">

                                <ImageView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="@drawable/backgoundputihtransparan"
                                    android:padding="10dp"
                                    android:src="@drawable/one_izin"
                                    app:tint="@color/white" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-black"
                                    android:text="Pengajuan Izin"
                                    android:textColor="@color/white"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:alpha="0.6"
                                    android:src="@drawable/one_search"
                                    android:rotation="180"
                                    app:tint="@color/white" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/clVerifikasi"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_margin="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="@color/merah"
                            app:cardCornerRadius="24dp"
                            app:layout_constraintTop_toBottomOf="@+id/cvMenuIzin"
                            app:strokeWidth="0dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="24dp">

                                <ImageView
                                    android:id="@+id/ivIconNotif"
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="@drawable/backgoundputihtransparan"
                                    android:padding="10dp"
                                    android:src="@drawable/one_notif"
                                    app:tint="@color/white" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:layout_weight="1"
                                    android:fontFamily="sans-serif-black"
                                    android:text="Menu Verifikasi"
                                    android:textColor="@color/white"
                                    android:textSize="16sp" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:alpha="0.6"
                                    android:src="@drawable/one_search"
                                    android:rotation="180"
                                    app:tint="@color/white" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Information Bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvTanggalContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_main"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:layout_constraintTop_toBottomOf="@+id/cvMainContainer"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/llTanggalToday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/one_calendar"
                        app:tint="@color/primary_brand" />

                    <TextView
                        android:id="@+id/tvTanggalHariIni"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/rabu_09_februari_1994"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. Synchronization Center -->
            <TextView
                android:id="@+id/tvSyncLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif-black"
                android:text="Pusat Sinkronisasi"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cvTanggalContainer" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/tvSyncLabel">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvJadwal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_main"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivJadwalIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/backgoundovalabuabu"
                            android:backgroundTint="#1AF06292"
                            android:padding="10dp"
                            android:src="@drawable/one_jadwal"
                            app:tint="@color/brand_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@+id/ivJadwalIcon"
                            android:fontFamily="sans-serif-medium"
                            android:text="Sinkron Jadwal"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvLokasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_main"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivLokasiIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/backgoundovalabuabu"
                            android:backgroundTint="#1AF7B620"
                            android:padding="10dp"
                            android:src="@drawable/one_lokasi"
                            app:tint="@color/kuning" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@+id/ivLokasiIcon"
                            android:fontFamily="sans-serif-medium"
                            android:text="Sinkron Lokasi"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:id="@+id/ivSingkronLokasi"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:alpha="0.2"
                                android:src="@drawable/one_search"
                                android:rotation="180" />

                            <ProgressBar
                                android:id="@+id/pgSingkronLokasi"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:indeterminateTint="@color/kuning"
                                android:visibility="gone" />
                        </FrameLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvKegiatan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_main"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivKegiatanIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/backgoundovalabuabu"
                            android:backgroundTint="#1A4CAF50"
                            android:padding="10dp"
                            android:src="@drawable/one_kegiatan"
                            app:tint="@color/hijau" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="16dp"
                            android:layout_toEndOf="@+id/ivKegiatanIcon"
                            android:fontFamily="sans-serif-medium"
                            android:text="Sinkron Kegiatan"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:id="@+id/ivSingkronKegiatan"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:alpha="0.2"
                                android:src="@drawable/one_search"
                                android:rotation="180" />

                            <ProgressBar
                                android:id="@+id/pgSingkronKegiatan"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:indeterminateTint="@color/hijau"
                                android:visibility="gone" />
                        </FrameLayout>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Bottom Sheet Overlays -->
            <View
                android:id="@+id/vOpenBottomSheet"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="#66000000"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/vOpenBottomSheetIzin"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="#66000000"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>