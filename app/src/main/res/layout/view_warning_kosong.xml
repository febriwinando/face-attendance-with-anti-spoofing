<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/backgoundovalputih"
    android:backgroundTint="@color/surface_main"
    android:gravity="center"
    android:padding="20dp"
    android:layout_margin="20dp"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">
        <ImageView
            android:id="@+id/emoticon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            app:srcCompat="@drawable/one_warning"
            app:tint="@color/kuning" />
        <TextView
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/emoticon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peringatan!"
            android:textSize="25sp"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            />

        <ImageView
            android:id="@+id/tvTutupDialog"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_centerVertical="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:src="@drawable/one_close"
            app:tint="@color/text_primary"
            android:focusable="true" />
    </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textAlignment="textStart"
                android:id="@+id/tvWarning1"
                />


    <TextView
        android:id="@+id/tvCobaKembali"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/backgoundovalbirusift"
        android:padding="10dp"
        android:textSize="18sp"
        android:text="@string/coba_kembali"
        android:textStyle="bold"
        android:textColor="@color/text_putih"/>
</LinearLayout>