<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_top_rounded"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header Title & Close -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvForwardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teruskan Pesan Ke"
            android:textColor="#0F172A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/ivCloseForwardSheet"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close"
            app:tint="#64748B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tutup" />
    </RelativeLayout>

    <!-- Message Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvForwardPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="14dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E8F0"
        app:cardBackgroundColor="#F8FAFC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <ImageView
                android:id="@+id/ivForwardPreviewIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_reply"
                app:tint="#16A34A"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tvForwardPreviewText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#334155"
                android:textSize="12.5sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Pesan yang akan diteruskan..." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Search Input -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#CBD5E1"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/one_search"
                app:tint="#64748B"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etSearchForward"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Cari nama pegawai atau OPD..."
                android:textColor="#0F172A"
                android:textColorHint="#94A3B8"
                android:textSize="13sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Contacts Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvForwardContacts"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbForwardLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginVertical="16dp"
        android:indeterminateTint="#16A34A"
        android:visibility="gone" />

</LinearLayout>

