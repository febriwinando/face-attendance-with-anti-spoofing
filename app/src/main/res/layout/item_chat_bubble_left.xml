<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- Date Header Separator (Centered) -->
    <LinearLayout
        android:id="@+id/llDateHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDateHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_date_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:textColor="#475569"
            android:textSize="11sp"
            android:textStyle="bold"
            android:elevation="0.5dp"
            android:text="Hari Ini"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvSenderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#16A34A"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/llBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/chat_bubble_left_bg"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Quote / Reply Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvReplyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="#CBD5E1"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#F1F5F9"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvReplySender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvReplyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Image / Media Attachment Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvImageContainer"
            android:layout_width="240dp"
            android:layout_height="180dp"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#F1F5F9"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivMessageImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Foto Media"/>

            <FrameLayout
                android:id="@+id/flVideoOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow"
                    android:background="@drawable/bg_circle_play"
                    android:padding="8dp"
                    app:tint="#FFFFFF"
                    android:contentDescription="Putar Video"/>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Telegram Style Audio Player Card (Left) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvAudioContainer"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="#E2E8F0"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/ivAudioPlayPause"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_play_arrow"
                    android:background="@drawable/bg_circle_play_green"
                    android:padding="6dp"
                    app:tint="#16A34A"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Putar Audio"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <SeekBar
                        android:id="@+id/sbAudioProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:progressTint="#16A34A"
                        android:thumbTint="#16A34A"
                        android:max="100"/>

                    <TextView
                        android:id="@+id/tvAudioDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0:00 / 0:00"
                        android:textColor="#475569"
                        android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Document Attachment Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvDocumentContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#E2E8F0"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/llDocumentContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/ivDocumentIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_document_scanner"
                    app:tint="#DC2626"
                    android:contentDescription="Dokumen"/>

                <TextView
                    android:id="@+id/tvDocumentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="middle"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Text Message -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0F172A"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:textColor="#94A3B8"
            android:textSize="10sp"/>
    </LinearLayout>
</LinearLayout>
