<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".verifikasi.fragvalidasi.masuk.MasukFragment"
    android:background="@android:color/transparent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp">

            <!-- Elegant Page Title -->
            <RelativeLayout
                android:id="@+id/rlHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/ivBackValidasi"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/one_left"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/ivBackValidasi"
                    android:fontFamily="sans-serif-black"
                    android:text="Validasi Masuk"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />
            </RelativeLayout>

            <!-- Verificator 1 Section -->
            <TextView
                android:id="@+id/tvv1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/backgoundovalabuabu"
                android:backgroundTint="@color/primary_brand"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="VERIFIKATOR PERTAMA"
                android:textColor="@color/on_primary_brand"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRekapMasukFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_validasi_new" />

            <!-- Verificator 2 Section -->
            <TextView
                android:id="@+id/tvv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/backgoundovalabuabu"
                android:backgroundTint="@color/brand_secondary"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="VERIFIKATOR KEDUA"
                android:textColor="@color/on_primary_brand"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVerivikatorKedua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="100dp"
                tools:listitem="@layout/item_validasi_new" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>