<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/llChatRoomRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:orientation="vertical">

    <!-- Header Bar (Clean White Mockup Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivBackChatRoom"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#0F172A"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Kembali"/>

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="12dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/civRoomAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_baseline_person_24"/>

            <FrameLayout
                android:id="@+id/flOpdHeaderContainer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_opd_badge"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivOpdHeaderIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_locasi_office"
                    app:tint="#16A34A"/>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRoomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvRoomSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCallAction"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_call"
            app:tint="#0F172A"
            android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Panggil"/>

        <ImageView
            android:id="@+id/ivRefreshChatRoom"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_sync2"
            app:tint="#64748B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Refresh"/>

        <ImageView
            android:id="@+id/ivMoreOptionsChatRoom"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@drawable/ic_more_vert"
            app:tint="#0F172A"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Menu Opsi"/>
    </LinearLayout>

    <!-- In-Chat Search Bar Container (Dynamic, Spacious, Modern) -->
    <LinearLayout
        android:id="@+id/llChatSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Search Input Field Capsule (Spacious & Clean) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_chat_search_capsule"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/ivSearchIconLeft"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/one_search"
                    app:tint="#0869D8"
                    android:contentDescription="Search"/>

                <EditText
                    android:id="@+id/etSearchInChat"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@null"
                    android:hint="Cari pesan di percakapan ini..."
                    android:textColor="#0F172A"
                    android:textColorHint="#94A3B8"
                    android:textSize="14sp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:gravity="center_vertical"/>

                <ImageView
                    android:id="@+id/ivClearChatSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="4dp"
                    android:src="@drawable/ic_close"
                    app:tint="#94A3B8"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Hapus teks"/>

            </LinearLayout>

            <!-- Dynamic Result Count Chip Badge -->
            <TextView
                android:id="@+id/tvSearchMatchCount"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:background="@drawable/bg_chat_search_count_chip"
                android:text="0/0"
                android:textColor="#0869D8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <!-- Navigation: Previous Match (Up) -->
            <FrameLayout
                android:id="@+id/flSearchPrev"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chat_search_nav_btn"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivSearchPrev"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_up"
                    app:tint="#0F172A"
                    android:contentDescription="Mundur"/>
            </FrameLayout>

            <!-- Navigation: Next Match (Down) -->
            <FrameLayout
                android:id="@+id/flSearchNext"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chat_search_nav_btn"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivSearchNext"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="#0F172A"
                    android:contentDescription="Maju"/>
            </FrameLayout>

            <!-- Close Search Button -->
            <FrameLayout
                android:id="@+id/flCloseChatSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/ivCloseChatSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="#64748B"
                    android:contentDescription="Tutup"/>
            </FrameLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E2E8F0" />
    </LinearLayout>

    <!-- Message List Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <!-- Modern & Cool Empty State View -->
        <LinearLayout
            android:id="@+id/llEmptyChatRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:visibility="gone">

            <!-- Glowing Layered Icon Container -->
            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_empty_chat_glow">

                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_empty_chat_circle">

                    <ImageView
                        android:id="@+id/ivEmptyChatIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chat_bubble_outline"
                        app:tint="#0869D8"
                        android:contentDescription="Ikon Chat"/>
                </FrameLayout>
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvEmptyChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Belum Ada Pesan"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:gravity="center"/>

            <!-- Info Message -->
            <TextView
                android:id="@+id/tvEmptyChatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tidak ada pesan pada halaman chat ini. Mulai percakapan resmi atau sampaikan pesan kedinasan Anda di sini."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:maxWidth="280dp"/>

            <!-- Status / Encryption Chip Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_empty_chat_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_security_lock"
                    app:tint="#0284C7"
                    android:contentDescription="Aman"/>

                <TextView
                    android:id="@+id/tvEmptyChatBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Layanan Chat Kedinasan SAHUT Terproteksi"
                    android:textColor="#0284C7"
                    android:textSize="11.5sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Quick Greeting Action Pill Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyChatQuickSay"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="18dp"
                android:text="Katakan Halo 👋"
                android:textSize="13sp"
                android:textColor="#0869D8"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="20dp"
                app:strokeColor="#BAE6FD"
                app:strokeWidth="1.2dp"
                app:backgroundTint="#F0F9FF"
                app:elevation="0dp"
                android:paddingHorizontal="18dp"/>

        </LinearLayout>

        <!-- Floating Scroll to Bottom Button with Unread Badge -->
        <FrameLayout
            android:id="@+id/flScrollToBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvScrollToBottom"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#CBD5E1"
                app:cardBackgroundColor="#FFFFFF">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_down"
                    app:tint="#0869D8"
                    android:contentDescription="Scroll ke Bawah"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvScrollToBottomBadge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:minWidth="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_pill_filter_active"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:text="1"
                android:textColor="#16A34A"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:elevation="5dp"
                android:visibility="gone"/>
        </FrameLayout>

        <ProgressBar
            android:id="@+id/pbChatRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#16A34A"/>
    </FrameLayout>

    <!-- Reply Preview Container -->
    <LinearLayout
        android:id="@+id/llReplyPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#E2E8F0"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReplyPreviewSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold"/>

            <TextView
                android:id="@+id/tvReplyPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCancelReply"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Batal Balas"/>
    </LinearLayout>

    <!-- Edit Message Preview Banner (Above Input Bar) -->
    <LinearLayout
        android:id="@+id/llEditPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FEF3C7"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_edit"
            app:tint="#D97706"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mengedit Pesan"
                android:textColor="#B45309"
                android:textSize="12sp"
                android:fontFamily="sans-serif-bold"/>

            <TextView
                android:id="@+id/tvEditPreviewText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#78350F"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/ivCancelEdit"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close"
            app:tint="#78350F"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Batal Edit"/>
    </LinearLayout>

    <!-- Input Bar Matching Floating Pill Style -->
    <LinearLayout
        android:id="@+id/llInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <!-- Far Left: Plus (+) Button for Attachments -->
        <ImageView
            android:id="@+id/ivAttachFile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_baseline_add"
            app:tint="#64748B"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Lampirkan File"/>

        <!-- Center Pill Input Box (Background #F3F4F6) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:background="@drawable/bg_pill_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/etMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Message"
                android:textColor="#0F172A"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp"
                android:minLines="1"
                android:maxLines="4"
                android:paddingVertical="8dp"
                android:gravity="start|center_vertical"
                android:inputType="textMultiLine|textCapSentences"/>

            <!-- Inside Pill: Mic Icon -->
            <ImageView
                android:id="@+id/ivDirectMic"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:src="@drawable/ic_mic"
                app:tint="#9CA3AF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Pesan Suara"/>

            <!-- Inside Pill: Camera Icon -->
            <ImageView
                android:id="@+id/ivDirectCamera"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:layout_marginStart="2dp"
                android:src="@drawable/ic_camera"
                app:tint="#9CA3AF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Ambil Foto"/>
        </LinearLayout>

        <!-- Right Side: Send Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendMessage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:enabled="false"
            android:visibility="gone"
            app:icon="@drawable/ic_send_line"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/putih"
            app:cornerRadius="20dp"
            android:backgroundTint="#CBD5E1"/>
    </LinearLayout>

</LinearLayout>
