<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/backgoundovalabuabu"
    android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvSearchDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            tools:text="Pilih OPD / Unit Kerja" />

        <ImageView
            android:id="@+id/ivCloseSearchDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_hint"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Search Bar EditText -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="#F8FAFC"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search_location"
                app:tint="@color/primary_brand"
                tools:ignore="ContentDescription" />

            <EditText
                android:id="@+id/etSearchDialogInput"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Cari..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp"
                tools:ignore="Autofill" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- List View for filtered items -->
    <ListView
        android:id="@+id/lvSearchDialogItems"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:divider="#F1F5F9"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />

</LinearLayout>
