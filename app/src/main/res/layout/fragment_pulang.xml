<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".verifikasi.fragvalidasi.pulang.PulangFragment"
    android:background="@android:color/transparent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp">

            <!-- Duplicate Header Hidden -->
            <RelativeLayout
                android:id="@+id/rlHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivBackValidasi"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/one_left"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/ivBackValidasi"
                    android:fontFamily="sans-serif-black"
                    android:text="Validasi Pulang"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvKosongValidasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:padding="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Tidak ada data validasi pulang yang menunggu verifikasi."
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

            <!-- Verificator 1 Section Header -->
            <TextView
                android:id="@+id/tvv1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/backgoundovalabuabu"
                android:backgroundTint="@color/primary_brand"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="VERIFIKATOR PERTAMA"
                android:textColor="@color/on_primary_brand"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/llBatchV1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <CheckBox
                    android:id="@+id/cbSelectAllV1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/primary_brand"
                    android:fontFamily="sans-serif-bold"
                    android:text="Pilih Semua"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatchTolakV1"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/merah"
                    android:fontFamily="sans-serif-bold"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="Tolak"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:cornerRadius="18dp"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatchTerimaV1"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/hijau"
                    android:fontFamily="sans-serif-bold"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="Terima"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:cornerRadius="18dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRekapPulangragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_validasi_new" />

            <!-- Verificator 2 Section Header -->
            <TextView
                android:id="@+id/tvv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/backgoundovalabuabu"
                android:backgroundTint="@color/brand_secondary"
                android:fontFamily="sans-serif-black"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:text="VERIFIKATOR KEDUA"
                android:textColor="@color/on_primary_brand"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/llBatchV2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_marginBottom="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <CheckBox
                    android:id="@+id/cbSelectAllV2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/brand_secondary"
                    android:fontFamily="sans-serif-bold"
                    android:text="Pilih Semua"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatchTolakV2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="@color/merah"
                    android:fontFamily="sans-serif-bold"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="Tolak"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:cornerRadius="18dp"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatchTerimaV2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/hijau"
                    android:fontFamily="sans-serif-bold"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"
                    android:text="Terima"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    app:cornerRadius="18dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVerivikatorKedua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_validasi_new" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
